{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Tự động chạy Postman collection tests khi code API thay đổi",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "c#/**/*.cs",
      "c#/appsettings.json",
      "c#/appsettings.Development.json",
      "c#/*.csproj"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code đã được thay đổi. Hãy kiểm tra file .postman.json. Nếu file không tồn tại hoặc trống, tạo Postman collection cho API. Nếu tồn tại, lấy collection ID và chạy collection, hiển thị kết quả và đề xuất sửa lỗi nếu có."
  }
}
